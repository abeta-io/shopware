{% sw_extends '@Storefront/storefront/base.html.twig' %}

{% block base_head %}
    {{ parent() }}

    {% if context.hasExtension('abetaSession') %}
        {% set punchoutCss = config('AbetaPunchOut.config.punchoutCss') %}
        {% if punchoutCss is not empty %}
            <style id="abeta-punchout-css">{{ punchoutCss|raw }}</style>
        {% endif %}
    {% endif %}
{% endblock %}
